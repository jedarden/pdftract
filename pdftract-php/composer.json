{
    "name": "jedarden/pdftract",
    "description": "PDFtract SDK - PDF extraction and conformance testing for PHP",
    "type": "library",
    "version": "1.0.0",
    "license": "MIT OR Apache-2.0",
    "authors": [
        {
            "name": "jedarden",
            "email": "github@jedarden.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Jedarden\\Pdftract\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jedarden\\Pdftract\\Tests\\": "tests/"
        }
    }
}
