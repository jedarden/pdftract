{
    "name": "jedarden/pdftract",
    "description": "PDFtract SDK - PDF extraction and conformance testing for PHP",
    "type": "library",
    "version": "{{ version }}",
    "license": "MIT",
    "authors": [
        {
            "name": "jedarden",
            "email": "jedarden@example.com"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Pdftract\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pdftract\\Tests\\": "tests/"
        }
    }
}
