    private function exec(array $args): string
    {
        $cmd = escapeshellcmd($this->binaryPath);
        foreach ($args as $arg) {
            $cmd .= ' ' . escapeshellarg($arg);
        }

        $output = [];
        $exitCode = 0;

        exec($cmd . ' 2>&1', $output, $exitCode);

        if ($exitCode !== 0) {
            throw $this->mapError(implode("\n", $output), $exitCode);
        }

        return implode("\n", $output);
    }

