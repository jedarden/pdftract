{
  "name": "@pdftract/sdk",
  "version": "{{ version }}",
  "description": "PDFtract SDK - PDF extraction and conformance testing for Node.js",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test test/codegen/conformance.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "pdf",
    "extraction",
    "ocr",
    "document-processing"
  ],
  "author": "jedarden",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "execa": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
