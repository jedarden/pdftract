        Open3.popen3(@binary_path, *args) do |stdin, stdout, stderr, wait_thr|
          return Enumerator.new do |yielder|
            stdout.each_line do |line|
              next if line.strip.empty?

              result = JSON.parse(line, object_class: OpenStruct)
              yielder << result
