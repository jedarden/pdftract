import json
import os
import unittest
from pathlib import Path

from pdftract_subprocess import Client, PathSource


class ConformanceTest(unittest.TestCase):
    """Test suite for SDK conformance."""

    def setUp(self):
        """Set up test client."""
        self.client = Client()
        self.suite_path = os.getenv(
            'CONFORMANCE_SUITE', 'tests/sdk-conformance/cases.json'
        )

        if os.path.exists(self.suite_path):
            with open(self.suite_path) as f:
                self.suite = json.load(f)
        else:
            self.suite = None

    def test_binary_available(self):
        """Test that pdftract binary is available on PATH."""
        import subprocess

        result = subprocess.run(
            ['pdftract', '--version'],
            capture_output=True,
        )
        self.assertEqual(
            0, result.returncode, 'pdftract binary not found on PATH'
        )

    def test_conformance(self):
        """Run all conformance test cases."""
        if not self.suite:
            self.skipTest('Conformance suite not available')

        for tc in self.suite.get('cases', []):
            with self.subTest(tc_id=tc['id'], method=tc['method']):
                fixture_path = f"fixtures/{tc['fixture']}"
                self._run_test_case(tc, fixture_path)

    def _run_test_case(self, test_case, fixture_path):
        """Run a single test case."""
        method = test_case['method']
        expected = test_case.get('expected')

        if method == 'extract':
            self._test_extract(fixture_path, expected)
        elif method == 'extract_text':
            self._test_extract_text(fixture_path, expected)
        elif method == 'extract_markdown':
            self._test_extract_markdown(fixture_path, expected)
        elif method == 'get_metadata':
            self._test_get_metadata(fixture_path, expected)
        elif method == 'hash':
            self._test_hash(fixture_path, expected)
        elif method == 'classify':
            self._test_classify(fixture_path, expected)
        elif method == 'verify_receipt':
            self._test_verify_receipt(fixture_path, expected)
        else:
            self.skipTest(f"Method not yet implemented: {method}")

    def _test_extract(self, fixture_path, expected):
        """Test extract method."""
        doc = self.client.extract(PathSource(fixture_path))

        if expected and 'page_count' in expected:
            self.assertEqual(expected['page_count'], len(doc['pages']))

        if expected and expected.get('has_title'):
            self.assertTrue(doc['metadata'].get('title'))

    def _test_extract_text(self, fixture_path, expected):
        """Test extract_text method."""
        text = self.client.extract_text(PathSource(fixture_path))

        if expected and 'min_length' in expected:
            self.assertGreaterEqual(len(text), expected['min_length'])

        if expected and 'contains' in expected:
            for substr in expected['contains']:
                self.assertIn(substr, text)

    def _test_extract_markdown(self, fixture_path, expected):
        """Test extract_markdown method."""
        md = self.client.extract_markdown(PathSource(fixture_path))

        if expected and 'min_length' in expected:
            self.assertGreaterEqual(len(md), expected['min_length'])

    def _test_get_metadata(self, fixture_path, expected):
        """Test get_metadata method."""
        metadata = self.client.get_metadata(PathSource(fixture_path))

        if expected and 'page_count' in expected:
            self.assertEqual(expected['page_count'], metadata['page_count'])

    def _test_hash(self, fixture_path, expected):
        """Test hash method."""
        fingerprint = self.client.hash(PathSource(fixture_path))

        self.assertEqual(64, len(fingerprint['hash']))
        self.assertEqual(64, len(fingerprint['fast_hash']))

        if expected and 'page_count' in expected:
            self.assertEqual(expected['page_count'], fingerprint['page_count'])

    def _test_classify(self, fixture_path, expected):
        """Test classify method."""
        classification = self.client.classify(PathSource(fixture_path))

        self.assertTrue(classification['category'])
        self.assertGreaterEqual(classification['confidence'], 0)
        self.assertLessEqual(classification['confidence'], 1)

    def _test_verify_receipt(self, fixture_path, expected):
        """Test verify_receipt method."""
        if not expected or 'receipt' not in expected:
            self.skipTest('Receipt not provided in expected')

        valid = self.client.verify_receipt(fixture_path, expected['receipt'])

        if 'valid' in expected:
            self.assertEqual(expected['valid'], valid)


